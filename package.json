{
  "name": "may",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "MAY (Maybe A Team You Need?): engineering team workflow for coding agents, as skills and small scripts.",
  "repository": "https://github.com/Rakhulsr/MAY",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "agent-skills"
  ],
  "engines": {
    "node": ">=26"
  },
  "files": [
    "skills/",
    "agents/",
    ".claude-plugin/",
    ".codex-plugin/",
    ".omp-plugin/",
    ".agents/",
    "AGENTS.md",
    "CLAUDE.md",
    "GEMINI.md",
    "README.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "assets/logo/Pixel MAY.png",
    "assets/diagrams/workflow.svg",
    "assets/diagrams/runtime-boundary.svg",
    "LICENSE",
    "CHANGELOG.md",
    "scripts/",
    "tests/",
    ".version-bump.json",
    ".gitattributes"
  ],
  "scripts": {
    "test": "node --test \"tests/*.test.ts\"",
    "check": "node scripts/bash.ts scripts/check-repo.sh",
    "test:harness": "node scripts/bash.ts scripts/test-harness.sh pi && node scripts/bash.ts scripts/test-harness.sh omp && node scripts/bash.ts scripts/test-harness.sh codex && node scripts/bash.ts scripts/test-harness.sh claude"
  },
  "pi": {
    "skills": [
      "./skills"
    ],
    "subagents": {
      "agents": [
        "./agents"
      ]
    }
  }
}
